<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Database Connection Settings -->
        <property name="connection.driver_class">org.sqlite.JDBC</property>
        <property name="connection.url">jdbc:sqlite:gestion_parc.db</property>
        <property name="connection.username"></property>
        <property name="connection.password"></property>

        <!-- Hibernate Connection Pool -->
        <property name="connection.pool_size">1</property>

        <!-- SQL Dialect -->
        <property name="dialect">org.hibernate.community.dialect.SQLiteDialect</property>

        <!-- Enable Hibernate's automatic session context management -->
        <property name="current_session_context_class">thread</property>

        <!-- Disable the second-level cache -->
        <property name="cache.provider_class">org.hibernate.cache.NoCacheProvider</property>

        <!-- Echo all executed SQL to stdout -->
        <property name="show_sql">true</property>

        <!-- Format SQL output -->
        <property name="format_sql">true</property>

        <!-- Automatically export schema DDL on startup -->
        <property name="hbm2ddl.auto">update</property>

        <!-- Mapping files -->
        <mapping class="com.gestionparc.model.Utilisateur"/>
        <mapping class="com.gestionparc.model.Admin"/>
        <mapping class="com.gestionparc.model.Chef"/>
        <mapping class="com.gestionparc.model.Chauffeur"/>
        <mapping class="com.gestionparc.model.TechnicienMaintenance"/>
        <mapping class="com.gestionparc.model.TypeVehicule"/>
        <mapping class="com.gestionparc.model.Vehicle"/>
        <mapping class="com.gestionparc.model.Camion"/>
        <mapping class="com.gestionparc.model.Voiture"/>
        <mapping class="com.gestionparc.model.Bus"/>
        <mapping class="com.gestionparc.model.ParcAuto"/>
        <mapping class="com.gestionparc.model.Mission"/>
        <mapping class="com.gestionparc.model.Maintenance"/>
        <mapping class="com.gestionparc.model.Carburant"/>
    </session-factory>
</hibernate-configuration>
